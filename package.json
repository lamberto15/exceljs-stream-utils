{
  "name": "exceljs-stream-utils",
  "version": "0.1.6",
  "description": "Streaming Excel read/write utilities built on top of exceljs",
  "author": "Lamberto Tamayo <lambertotamayo15@gmail.com>",
  "license": "MIT",
  "private": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./v2": {
      "types": "./dist/v2.d.ts",
      "default": "./dist/v2.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "bun test"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lamberto15/exceljs-stream-utils.git"
  },
  "bugs": {
    "url": "https://github.com/lamberto15/exceljs-stream-utils/issues"
  },
  "homepage": "https://github.com/lamberto15/exceljs-stream-utils#readme",
  "dependencies": {
    "@protobi/exceljs": "^4.4.0-protobi.10",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
